---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Copy from '../../components/Copy.astro';
import ListRow from '../../components/ListRow.astro';
import { copy } from '../../data/copy';

const t = copy.blog;

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const y = post.data.date.getFullYear();
	byYear.set(y, [...(byYear.get(y) ?? []), post]);
}
const fmt = (d: Date) => d.toLocaleDateString('en-us', { month: 'short', day: '2-digit' });
---

<Layout title={t.title} description={t.description} narrow>
	<section class="mx-auto w-full max-w-2xl px-5 py-24 sm:px-8 sm:py-32">
		<h1 class="animate-rise font-title text-base font-semibold tracking-tight"><Copy text={t.heading} /></h1>

		{[...byYear.entries()].map(([year, list], i) => (
			<div class="animate-rise" style={`--rise: ${i + 1}`}>
				<h2 class="mt-14 font-title text-base font-semibold tracking-tight">{year}</h2>
				<ul class="group/list mt-3 flex flex-col">
					{list.map((post) => (
						<li>
							<ListRow title={post.data.title} meta={fmt(post.data.date)} href={`/blog/${post.id}/`}>
								{post.data.description}
							</ListRow>
						</li>
					))}
				</ul>
			</div>
		))}
	</section>
</Layout>
