---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const y = post.data.date.getFullYear();
	byYear.set(y, [...(byYear.get(y) ?? []), post]);
}
const fmt = (d: Date) => d.toLocaleDateString('en-us', { month: 'short', day: '2-digit' });
---

<Layout title="Blog" description="Notes on design, code, music and whatever else.">
	<div class="mx-auto w-full max-w-5xl px-5 sm:px-8">
		<header class="border-b border-line py-16">
			<p class="label mb-4">Blog · {posts.length} posts</p>
			<h1 class="font-title text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Notes on design, code<br />and the occasional chord.</h1>
		</header>

		{[...byYear.entries()].map(([year, list]) => (
			<section class="grid gap-x-8 border-b border-line py-10 last:border-0 sm:grid-cols-[10rem_1fr]">
				<h2 class="label mb-4 pt-4 sm:mb-0">{year}</h2>
				<ul class="flex flex-col">
					{list.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} class="group -mx-3 grid grid-cols-[auto_1fr] items-baseline gap-x-5 rounded-lg px-3 py-3 transition-colors hover:bg-canvas-muted">
								<time datetime={post.data.date.toISOString()} class="label w-14">{fmt(post.data.date)}</time>
								<span class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:gap-3">
									<span class="text-base font-medium tracking-tight">{post.data.title}</span>
									<span class="text-sm text-content-muted">{post.data.description}</span>
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		))}
	</div>
</Layout>
