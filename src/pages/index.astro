---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import Copy from '../components/Copy.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { copy, fill } from '../data/copy';
import { experience, featuredProjects } from '../data/work';

const t = copy.home;
const now = experience.find((e) => e.current);
const current = now ? fill(t.current, { company: now.company, url: now.url ?? '' }) : '';
---

<Layout title={copy.site.title} description={copy.site.description} narrow>
	<section class="mx-auto w-full max-w-2xl px-5 py-24 sm:px-8 sm:py-32">
		<h1 class="animate-rise font-title text-base font-semibold tracking-tight">{t.heading}</h1>
		<p class="animate-rise mt-4 leading-relaxed text-content-muted text-pretty" style="--rise: 1">
			<Copy text={t.intro} vars={{ current }} linkClass="link-sweep text-content" />
		</p>

		<h2 class="animate-rise mt-14 font-title text-base font-semibold tracking-tight" style="--rise: 2">{t.work.title}</h2>
		<ul class="group/list mt-3 flex flex-col">
			{featuredProjects.map((p, i) => (
				<li class="animate-rise" style={`--rise: ${i + 3}`}><ProjectRow project={p} /></li>
			))}
		</ul>

		<a
			href="/work"
			class="animate-rise group mt-8 inline-flex items-center gap-1 text-sm text-content"
			style={`--rise: ${featuredProjects.length + 3}`}
		>
			<span class="link-sweep">{t.work.link}</span>
			<Icon name="solar:arrow-right-up-linear" class="arrow size-3 text-primary" />
		</a>
	</section>
</Layout>
