---
import Layout from '../layouts/Layout.astro';
import { copy } from '../data/copy';

const t = copy.notFound;
---

<Layout title={t.title} description={t.description}>
	<div class="mx-auto flex max-w-5xl flex-1 flex-col items-start justify-center px-5 py-24 sm:px-8">
		<p class="label mb-4">{t.eyebrow}</p>
		<h1 class="font-title text-4xl font-semibold tracking-tight">{t.heading}</h1>
		<a href="/" class="link mt-6 text-sm text-content-muted">{t.back}</a>
	</div>
</Layout>
