---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import { copy } from '../data/copy';

const t = copy.notFound;
---

<Layout title={t.title} description={t.description} narrow>
	<section class="mx-auto w-full max-w-2xl px-5 py-24 sm:px-8 sm:py-32">
		<h1 class="animate-rise font-title text-base font-semibold tracking-tight">{t.heading}</h1>
		<a href="/" class="animate-rise group mt-8 inline-flex items-center gap-1 text-sm text-content" style="--rise: 1">
			<span class="link-sweep">{t.back}</span>
			<Icon name="solar:arrow-right-up-linear" class="arrow size-3 text-primary" />
		</a>
	</section>
</Layout>
