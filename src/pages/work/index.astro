---
import { Icon } from 'astro-icon/components';
import PosterDeck from '../../components/PosterDeck.astro';
import Layout from '../../layouts/Layout.astro';
import Copy from '../../components/Copy.astro';
import ListRow from '../../components/ListRow.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { experience, projects } from '../../data/work';
import { posters } from '../../data/posters';
import { copy, fill } from '../../data/copy';

const t = copy.work;

const live = projects.filter((p) => p.status === 'live' || p.status === 'building');
const rest = projects.filter((p) => p.status === 'archived' || p.status === 'unfinished');
---

<Layout title={t.title} description={t.description} narrow>
	<section class="mx-auto w-full max-w-2xl px-5 py-24 sm:px-8 sm:py-32">
		<h1 class="animate-rise font-title text-base font-semibold tracking-tight"><Copy text={t.heading} /></h1>
		<p class="animate-rise mt-4 leading-relaxed text-content-muted text-pretty" style="--rise: 1">{t.projects.intro}</p>

		<div class="animate-rise" style="--rise: 2">
			<h2 id="projects" class="mt-14 scroll-mt-24 font-title text-base font-semibold tracking-tight">{t.projects.title}</h2>
			<ul class="group/list mt-3 flex flex-col">
				{live.map((p) => <li><ProjectRow project={p} detailed /></li>)}
			</ul>
			{rest.length > 0 && (
				<details class="group/d mt-6">
					<summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-sm text-content-muted transition-colors select-none hover:text-content">
						<Icon name="solar:add-circle-linear" class="size-3.5 group-open/d:hidden" />
						<Icon name="solar:minus-circle-linear" class="hidden size-3.5 group-open/d:block" />
						<span class="group-open/d:hidden">{fill(t.projects.showRest, { count: rest.length })}</span>
						<span class="hidden group-open/d:inline">{t.projects.hideRest}</span>
					</summary>
					<ul class="group/list mt-3 flex flex-col">
						{rest.map((p) => <li><ProjectRow project={p} detailed /></li>)}
					</ul>
				</details>
			)}
		</div>

		<div class="animate-rise" style="--rise: 3">
			<h2 id="experience" class="mt-14 scroll-mt-24 font-title text-base font-semibold tracking-tight">{t.experience.title}</h2>
			<ul class="timeline group/list mt-3 flex flex-col">
				{experience.map((e) => (
					<li class:list={['pb-4', e.current && 'is-current']}>
						<ListRow title={e.company} meta={[e.start, e.current ? copy.common.now : e.end].filter(Boolean).join('–')} href={e.url}>
							{e.current && <span slot="badge" class="label self-center text-primary">{t.experience.current}</span>}
							<p class="text-content">{e.role}</p>
							<p class="mt-2">{e.summary}</p>
							{e.details && (
								<ul class="mt-3 flex flex-col gap-3">
									{e.details.map((d) => (
										<li class="flex gap-2.5"><Icon name="solar:minus-circle-linear" class="mt-1 size-3 shrink-0 text-content-subtle" /><span>{d}</span></li>
									))}
								</ul>
							)}
						</ListRow>
					</li>
				))}
			</ul>
		</div>

		<div class="animate-rise" style="--rise: 4">
			<h2 id="posters" class="mt-14 scroll-mt-24 font-title text-base font-semibold tracking-tight">{t.posters.title}</h2>
			<p class="mt-2 text-content-muted text-pretty">{t.posters.intro}</p>
			<PosterDeck posters={posters} label={t.posters.deck} hint={t.posters.hint} prev={t.posters.prev} next={t.posters.next} />
		</div>
	</section>
</Layout>

<style>
	/* Hanging timeline: the rail sits in the gutter so text stays aligned with the headings.
	   Each entry draws a dot on its title line and a segment down to the next entry's dot. */
	.timeline > li {
		--x: -0.75rem;
		--y: 1.375rem; /* ListRow padding + half a title line */
		position: relative;
	}
	@media (min-width: 40rem) {
		.timeline > li {
			--x: -1.25rem;
		}
	}
	.timeline > li::before,
	.timeline > li::after {
		content: '';
		position: absolute;
		left: var(--x);
		translate: -50% 0;
		pointer-events: none;
	}
	.timeline > li:not(:last-child)::before {
		top: var(--y);
		bottom: calc(var(--y) * -1);
		width: 1px;
		background: var(--line);
	}
	.timeline > li::after {
		top: var(--y);
		translate: -50% -50%;
		width: 5px;
		height: 5px;
		border-radius: 9999px;
		background: var(--line-strong);
		transition: background-color 300ms;
	}
	.timeline > li.is-current::after {
		background: var(--primary);
		box-shadow: 0 0 0 3px var(--primary-subtle);
	}
	.timeline > li:has(a:is(:hover, :focus-visible))::after {
		background: var(--primary);
	}
</style>
