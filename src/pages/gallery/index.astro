---
import Layout from '../../layouts/Layout.astro';
import Copy from '../../components/Copy.astro';
import RoomCard from '../../components/RoomCard.astro';
import { getRooms } from '../../data/exhibitions';
import { copy } from '../../data/copy';

const t = copy.gallery;

const rooms = await getRooms();
// The permanent room leads. The others keep the order from the data.
const featured = rooms.find((r) => r.entry.data.status === 'permanent');
const others = rooms.filter((r) => r !== featured);
---

<Layout title={t.title} description={t.description} narrow>
	<section class="mx-auto w-full max-w-2xl px-5 py-24 sm:px-8 sm:py-32">
		<h1 class="animate-rise font-title text-base font-semibold tracking-tight"><Copy text={t.heading} /></h1>

		{featured && (
			<div class="animate-rise" style="--rise: 1">
				<h2 class="mt-14 font-title text-base font-semibold tracking-tight">{t.permanent}</h2>
				<div class="mt-6">
					<RoomCard room={featured} featured />
				</div>
			</div>
		)}

		{others.length > 0 && (
			<div class="animate-rise" style="--rise: 2">
				<h2 class="mt-14 font-title text-base font-semibold tracking-tight">{t.others}</h2>
				<div class="mt-6 grid gap-x-6 gap-y-10 sm:grid-cols-2">
					{others.map((room) => <RoomCard room={room} />)}
				</div>
			</div>
		)}
	</section>
</Layout>
