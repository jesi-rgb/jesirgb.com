---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getRooms, groups, statusDot, statusLabel } from '../../data/exhibitions';

const rooms = await getRooms();
const total = rooms.reduce((n, r) => n + r.photos.length, 0);
const shown = groups.map((g) => ({ ...g, rooms: rooms.filter((r) => r.entry.data.status === g.status) })).filter((g) => g.rooms.length > 0);
---

<Layout title="Gallery" description="Photo exhibitions. Some stay up, some come down.">
	<div class="mx-auto w-full max-w-5xl px-5 sm:px-8">
		<header class="flex flex-col gap-4 border-b border-line py-16">
			<p class="label">Gallery · {rooms.length} exhibitions · {total} photos</p>
			<h1 class="font-title text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Rooms</h1>
			<p class="max-w-xl text-lg leading-relaxed text-content-muted text-pretty">
				I hang photos in small groups. A few stay on the wall for good. The rest run for a while, then make room for the next set.
			</p>
		</header>

		{shown.map((group, gi) => (
			<section class="py-12">
				<SectionHeading index={String(gi + 1).padStart(2, '0')} title={group.title} />
				<p class="label -mt-5 mb-8">{group.note}</p>

				<div class="flex flex-col">
					{group.rooms.map((room) => (
						<a
							href={room.href}
							class="group -mx-3 grid gap-5 rounded-lg border-b border-line px-3 py-6 transition-colors hover:bg-canvas-muted sm:grid-cols-[1fr_auto] sm:items-center sm:gap-8"
						>
							<div>
								<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
									<h3 class="font-title flex items-center gap-2.5 text-2xl font-semibold tracking-tight">
										<span class:list={['size-1.5 shrink-0 rounded-full', statusDot[room.entry.data.status]]} aria-hidden="true"></span>
										{room.entry.data.title}
									</h3>
									<span class="label">{room.photos.length} photos</span>
									<Icon name="solar:arrow-right-up-linear" class="arrow size-3 text-content-muted" />
								</div>
								<p class="label mt-2">{room.entry.data.status === 'permanent' ? room.dates : `${statusLabel[room.entry.data.status]} · ${room.dates}`}</p>
								{room.entry.data.subtitle && (
									<p class="mt-3 max-w-md text-sm text-content-muted text-pretty">{room.entry.data.subtitle}</p>
								)}
							</div>

							<div class="flex gap-2">
								{room.photos.slice(0, 3).map((p, i) => (
									<div class:list={['w-24 overflow-hidden rounded-md bg-canvas-muted sm:w-28', i > 0 && 'hidden sm:block']}>
										<Image
											src={p.data.src}
											alt=""
											width={320}
											densities={[1, 2]}
											class="aspect-[4/3] w-full object-cover transition-transform duration-500 ease-out-quart group-hover:scale-[1.04]"
											loading="lazy"
										/>
									</div>
								))}
							</div>
						</a>
					))}
				</div>
			</section>
		))}
	</div>
</Layout>
