---
import { Icon } from 'astro-icon/components';
import { getImage } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import PhotoMeta from '../../../components/PhotoMeta.astro';
import { filmName, getRooms, photoHref } from '../../../data/exhibitions';
import { copy } from '../../../data/copy';

export async function getStaticPaths() {
	const rooms = await getRooms();
	return rooms.flatMap((room) =>
		room.photos.map((photo, i) => ({
			params: { exhibition: room.slug, photo: photo.id },
			props: {
				photo,
				room,
				prev: room.photos[i - 1]?.id,
				next: room.photos[i + 1]?.id,
				index: i + 1,
			},
		})),
	);
}

const { photo, room, prev, next, index } = Astro.props;
// The photo box is the viewport less the side panel and padding. Portrait photos
// come out narrower than this, so the guess errs on the sharp side.
const sizes = '(min-width: 1024px) calc(100vw - 21rem), calc(100vw - 2rem)';
const widths = [800, 1200, 1800, 2800];
// AVIF holds the same look in about two thirds of the bytes. WebP is the fallback.
const [avif, webp] = await Promise.all([
	getImage({ src: photo.data.src, width: 1800, widths, sizes, format: 'avif', quality: 60 }),
	getImage({ src: photo.data.src, width: 1800, widths, sizes, format: 'webp', quality: 85 }),
]);
const title = photo.data.caption ?? `${room.entry.data.title} · ${index}`;
const description = [photo.data.camera, photo.data.lens, photo.data.film ? filmName(photo.data.film) : photo.data.simulation].filter(Boolean).join(' · ') || copy.photo.description;
const prevHref = prev && photoHref(room.slug, prev);
const nextHref = next && photoHref(room.slug, next);
const step = 'grid h-20 place-items-center rounded-lg border border-line text-content-muted transition-colors active:bg-canvas-subtle active:text-content';
---

<Layout title={title} description={description} bare class="h-dvh overflow-hidden">
	<div class="flex h-12 shrink-0 items-center justify-between border-b border-line px-4">
		<a href={room.href} class="label flex items-center gap-1 truncate transition-colors hover:text-content">
			<Icon name="solar:arrow-left-bold-duotone" class="size-3 shrink-0" /> {room.entry.data.title}
		</a>
		<span class="label">{index} / {room.photos.length}</span>
		<div class="flex items-center gap-1">
			{prevHref ? <a href={prevHref} class="grid size-8 place-items-center rounded-md text-content-muted hover:bg-canvas-subtle hover:text-content" aria-label={copy.photo.prev}><Icon name="solar:alt-arrow-left-bold-duotone" class="size-4" /></a> : <span class="size-8"></span>}
			{nextHref ? <a href={nextHref} class="grid size-8 place-items-center rounded-md text-content-muted hover:bg-canvas-subtle hover:text-content" aria-label={copy.photo.next}><Icon name="solar:alt-arrow-right-bold-duotone" class="size-4" /></a> : <span class="size-8"></span>}
		</div>
	</div>
	<div class="grid min-h-0 flex-1 grid-rows-[1fr_auto] lg:grid-cols-[1fr_18rem] lg:grid-rows-1">
		<!-- On mobile the photo box takes the photo's ratio, so the photo sits at the top
		     and the space left goes to the prev/next buttons. On desktop an absolute inset
		     gives the photo a definite box, so tall photos fit. -->
		<div class="relative flex min-h-0 flex-col">
			<div class="relative min-h-0 w-full aspect-(--ratio) lg:absolute lg:inset-0 lg:aspect-auto" style={`--ratio: ${photo.data.src.width} / ${photo.data.src.height}`}>
				<picture>
					<source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
					<img
						src={webp.src}
						srcset={webp.srcSet.attribute}
						sizes={sizes}
						alt={photo.data.alt || photo.id}
						class="absolute inset-0 size-full object-contain p-4 lg:p-6"
						fetchpriority="high"
						draggable="false"
					/>
				</picture>
			</div>
			<nav class="grid min-h-24 flex-1 grid-cols-2 content-start gap-3 px-4 pb-4 lg:hidden">
				{prevHref ? <a href={prevHref} class={step} aria-label={copy.photo.prev}><Icon name="solar:alt-arrow-left-bold-duotone" class="size-6" /></a> : <span class:list={[step, 'opacity-30']} aria-hidden="true"><Icon name="solar:alt-arrow-left-bold-duotone" class="size-6" /></span>}
				{nextHref ? <a href={nextHref} class={step} aria-label={copy.photo.next}><Icon name="solar:alt-arrow-right-bold-duotone" class="size-6" /></a> : <span class:list={[step, 'opacity-30']} aria-hidden="true"><Icon name="solar:alt-arrow-right-bold-duotone" class="size-6" /></span>}
			</nav>
		</div>
		<aside class="max-h-[40dvh] overflow-y-auto border-t border-line px-6 py-4 lg:max-h-none lg:border-l lg:border-t-0 lg:py-6">
			<p class="label mb-1">{room.entry.data.title} · {String(index).padStart(2, '0')}</p>
			{photo.data.caption && <p class="mb-4 text-sm text-content">{photo.data.caption}</p>}
			<PhotoMeta photo={photo.data} class="lg:grid-cols-1 lg:gap-y-1 lg:[&>dt]:pt-3" />
		</aside>
	</div>
</Layout>

<script define:vars={{ prevHref, nextHref, roomHref: room.href }}>
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowLeft' && prevHref) location.href = prevHref;
		if (e.key === 'ArrowRight' && nextHref) location.href = nextHref;
		if (e.key === 'Escape') location.href = roomHref;
	});
</script>
