---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import Copy from '../../components/Copy.astro';
import VideoCard from '../../components/VideoCard.astro';
import { videosByChannel } from '../../data/videos';
import { copy } from '../../data/copy';

const t = copy.videos;
---

<Layout title={t.title} description={t.description} narrow>
	<section class="mx-auto w-full max-w-2xl px-5 py-24 sm:px-8 sm:py-32">
		<h1 class="animate-rise font-title text-base font-semibold tracking-tight"><Copy text={t.heading} /></h1>
		<p class="animate-rise mt-4 leading-relaxed text-content-muted text-pretty" style="--rise: 1">{t.intro}</p>

		{videosByChannel.map((group, i) => (
			<div class="animate-rise" style={`--rise: ${i + 2}`}>
				<h2 class="mt-14 font-title text-base font-semibold tracking-tight">
					<a
						href={group.channel.url}
						target="_blank"
						rel="noopener noreferrer"
						title={t.channelLink}
						class="group inline-flex items-center gap-1.5"
					>
						<span class="link-sweep">{group.channel.name}</span>
						<Icon name="solar:video-library-bold-duotone" aria-hidden="true" class="size-4 text-primary transition-transform duration-300 ease-out-quart group-hover:scale-110" />
					</a>
				</h2>
				<p class="mt-1 text-sm text-content-muted text-pretty">{group.channel.role}</p>
				<div class="mt-6 grid gap-x-6 gap-y-10 sm:grid-cols-2">
					{group.videos.map((v) => <VideoCard video={v} />)}
				</div>
			</div>
		))}
	</section>
</Layout>
