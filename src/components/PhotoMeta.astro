---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { copy } from '../data/copy';

interface Props {
	photo: CollectionEntry<'gallery'>['data'];
	class?: string;
}
const { photo: p, class: className } = Astro.props;

const t = copy.photo.meta;
const focal = p.focalLength && (p.focalLength35 ? `${p.focalLength} (${p.focalLength35} eq.)` : p.focalLength);
const settings = [focal, p.aperture, p.shutter, p.iso && `ISO ${p.iso}`, p.exposureCompensation].filter(Boolean).join(' · ');
const film = p.film && [p.film.stock, p.film.iso && `ISO ${p.film.iso}`, p.film.format].filter(Boolean).join(' · ');
const recipe = p.recipe ? (Object.keys(t.recipe) as (keyof typeof t.recipe)[]).map((k): [string, string | undefined] => [t.recipe[k], p.recipe?.[k]]) : [];
const rows: [string, string | undefined][] = [
	[t.camera, p.camera],
	[t.lens, p.lens],
	[t.settings, settings || undefined],
	[t.mode, p.mode],
	[t.metering, p.metering],
	[t.manufacturer, p.film?.manufacturer],
	[t.film, film],
	[t.scan, p.film?.scan],
	[t.simulation, p.film ? undefined : p.simulation],
	...recipe,
	[t.look, p.mono ? t.mono : t.color],
	[t.location, p.location],
];
---

<dl class:list={['grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm', className]}>
	{rows.filter(([, v]) => v).map(([k, v]) => (
		<>
			<dt class="label pt-0.5">{k}</dt>
			<dd class="mono-num text-content">{v}</dd>
		</>
	))}
	{p.date && (
		<>
			<dt class="label pt-0.5">{t.date}</dt>
			<dd class="mono-num text-content"><FormattedDate date={p.date} /></dd>
		</>
	)}
	{p.tags.length > 0 && (
		<>
			<dt class="label pt-0.5">{t.tags}</dt>
			<dd class="flex flex-wrap gap-1.5">
				{p.tags.map((t) => (
					<span class="rounded-full border border-line px-2 py-0.5 text-2xs text-content-muted">{t}</span>
				))}
			</dd>
		</>
	)}
</dl>
