---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { Room } from '../data/exhibitions';

interface Props {
	room: Room;
	// The permanent room spans the column and shows more of the room. Its title is the section heading, so the card drops it.
	featured?: boolean;
}
const { room, featured = false } = Astro.props;
const { entry, photos, cover } = room;

// The peek row shows the room behind the cover.
const peek = photos.filter((p) => p.id !== cover.id).slice(0, featured ? 5 : 3);
---

<a href={room.href} class="group flex flex-col gap-3" aria-label={featured ? entry.data.title : undefined}>
	<div class="flex flex-col gap-1.5">
		<div class="overflow-hidden rounded-lg border border-line bg-canvas-muted">
			<Image
				src={cover.data.src}
				alt=""
				width={featured ? 720 : 400}
				densities={[1, 2]}
				class="aspect-[3/2] w-full object-cover transition-transform duration-500 ease-out-quart group-hover:scale-[1.03]"
				loading={featured ? 'eager' : 'lazy'}
			/>
		</div>
		{peek.length > 0 && (
			<div class:list={['grid gap-1.5', featured ? 'grid-cols-5' : 'grid-cols-3']}>
				{peek.map((p) => (
					<div class="overflow-hidden rounded-md border border-line bg-canvas-muted">
						<Image
							src={p.data.src}
							alt=""
							width={200}
							densities={[1, 2]}
							class="aspect-square w-full object-cover opacity-80 transition-opacity duration-300 group-hover:opacity-100"
							loading="lazy"
						/>
					</div>
				))}
			</div>
		)}
	</div>

	{!featured && (
		<h3 class="text-base font-medium leading-snug tracking-tight text-pretty">
			{entry.data.title}
			<Icon name="solar:arrow-right-up-linear" class="arrow ml-0.5 inline-block size-3 align-[1px] text-content-muted" />
		</h3>
	)}
</a>
