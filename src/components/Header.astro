---
import { Icon } from 'astro-icon/components';
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname;
const navLinks = [
	{ href: '/work', label: 'Work' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/gallery', label: 'Gallery' },
];
const isActive = (href: string) => pathname.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-line bg-canvas/80 backdrop-blur-md">
	<nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-5 sm:px-8">
		<a href="/" class="flex items-center gap-2.5 text-sm font-medium tracking-tight">
			<span class="size-2 rounded-full bg-primary" aria-hidden="true"></span>
			{SITE_TITLE}
		</a>

		<div class="flex items-center gap-1">
			<ul class="flex items-center">
				{navLinks.map(({ href, label }) => (
					<li>
						<a
							href={href}
							aria-current={isActive(href) ? 'page' : undefined}
							class:list={[
								'relative px-3 py-1.5 text-sm transition-colors',
								isActive(href) ? 'text-content' : 'text-content-muted hover:text-content',
							]}
						>
							{label}
							{isActive(href) && (
								<span class="absolute inset-x-3 -bottom-[17px] h-px bg-content" aria-hidden="true"></span>
							)}
						</a>
					</li>
				))}
			</ul>

			<button
				id="theme-toggle"
				class="ml-2 grid size-8 place-items-center rounded-md text-content-muted transition-colors hover:bg-canvas-subtle hover:text-content"
				aria-label="Toggle theme"
			>
				<Icon name="solar:sun-2-linear" class="size-4 dark:hidden" />
				<Icon name="solar:moon-stars-linear" class="hidden size-4 dark:block" />
			</button>
		</div>
	</nav>
</header>

<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const dark = document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', dark ? 'dark' : 'light');
	});
</script>
