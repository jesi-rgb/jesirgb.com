---
import ListRow from './ListRow.astro';
import type { Project } from '../data/work';
import { copy } from '../data/copy';

interface Props {
	project: Project;
	// Longer text, for /work.
	detailed?: boolean;
}
const { project: p, detailed = false } = Astro.props;
---

<ListRow title={p.name} meta={p.year} href={p.url}>
	{p.status !== 'live' && (
		<span slot="badge" class:list={['label flex items-center gap-1.5 self-center', p.status === 'building' && 'text-primary']}>
			{p.status === 'building' && <span class="size-1.5 animate-pulse rounded-full bg-primary" aria-hidden="true"></span>}
			{copy.work.status[p.status]}
		</span>
	)}
	{detailed ? (p.details ?? p.description) : p.description}
</ListRow>
