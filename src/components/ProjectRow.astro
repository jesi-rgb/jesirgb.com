---
import { Icon } from 'astro-icon/components';
import type { Project } from '../data/work';

interface Props {
	project: Project;
	compact?: boolean;
}
const { project: p, compact = false } = Astro.props;
const external = p.url.startsWith('http');

const statusLabel: Record<Project['status'], string> = {
	live: 'Live',
	building: 'Building',
	archived: 'Archived',
	unfinished: 'Unfinished',
};
const statusColor: Record<Project['status'], string> = {
	live: 'bg-primary',
	building: 'bg-accent animate-pulse',
	archived: 'bg-content-subtle',
	unfinished: 'bg-content-subtle',
};
---

<a
	href={p.url}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	class="group -mx-3 grid grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-1 rounded-lg px-3 py-3.5 transition-colors hover:bg-canvas-muted sm:grid-cols-[minmax(0,14rem)_1fr_auto]"
>
	<h3 class="flex items-center gap-2.5 text-base font-medium tracking-tight">
		<span class:list={['size-1.5 shrink-0 rounded-full', statusColor[p.status]]} aria-hidden="true"></span>
		{p.name}
	</h3>
	<span class="label sm:order-3">
		{p.year}
		<span class="ml-2 hidden sm:inline">{statusLabel[p.status]}</span>
		<Icon name="solar:arrow-right-up-linear" class="arrow ml-1.5 inline-block size-3 align-[-1px] text-content-muted" />
	</span>
	<p class="col-span-2 text-sm text-content-muted text-pretty sm:col-span-1 sm:order-2">
		{compact ? p.description : (p.details ?? p.description)}
		{!compact && p.stack && (
			<span class="label ml-2 normal-case tracking-normal">{p.stack.join(' · ')}</span>
		)}
	</p>
</a>
